FROM apache/airflow:2.1.4

# Use root to prepare directories and permissions
USER root

ENV PROJECT_HOME=/opt/airflow

# Create standard Airflow directories with correct permissions
RUN mkdir -p /opt/airflow/dags /opt/airflow/logs /opt/airflow/plugins \
    /opt/airflow/resources /opt/airflow/data && \
    chown -R airflow:root /opt/airflow && \
    chmod -R 775 /opt/airflow

# Copy and set permissions for role-based startup script
COPY start-airflow.sh /usr/local/bin/start-airflow.sh
RUN chmod +x /usr/local/bin/start-airflow.sh

# Switch back to airflow user to run services
USER airflow

# Default command delegates to role-based script
CMD ["/usr/local/bin/start-airflow.sh"]
