metadata:
  name: spark-worker
spec:
  replicas: 2
  selector:
    matchLabels:
      app: spark-worker
  template:
    metadata:
      labels:
        app: spark-worker
    spec:
      securityContext:
          runAsUser: 50000    # Obliga a correr como usuario 50000 (Airflow)
          runAsGroup: 0       # Opcional: Grupo root (común en Bitnami/Apache)
          fsGroup: 0
      containers:
      - name: spark-worker
        image: stehedor/spark-custom:latest
        # image: apache/spark:3.5.3
        command:
          - /opt/spark/bin/spark-class
          - org.apache.spark.deploy.worker.Worker
          - spark://spark-master:7077
        env:
          # --- AÑADE ESTAS VARIABLES PARA ARREGLAR EL LOGIN ---
          - name: SPARK_USER
            value: "airflow"
          - name: HADOOP_USER_NAME
            value: "airflow"
          - name: USER
            value: "airflow"
