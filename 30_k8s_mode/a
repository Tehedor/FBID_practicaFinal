# airflow-init
apiVersion: batch/v1
kind: Job
metadata:
  name: airflow-init
spec:
  backoffLimit: 5
  template:
    spec:
      restartPolicy: OnFailure
      initContainers:
      - name: fix-volume-permissions
        image: busybox
        securityContext:
          runAsUser: 0  # Corre como root
        command: ["sh", "-c", "chown -R 50000:0 /opt/airflow && chmod -R 775 /opt/airflow"]
        volumeMounts:
          - name: airflow-filestore
            mountPath: /opt/airflow
      containers:
      - name: airflow-init
        image: stehedor/airflow-custom:latest
        command: ["/bin/bash", "-c"]
        args:
          - |
            echo "⏳ Waiting for Postgres..."
            until pg_isready -h airflow-postgres -p 5432 -U airflow; do
              sleep 3
            done

            echo "✅ Postgres ready"

            mkdir -p /opt/airflow/{logs,dags,plugins}

            airflow db upgrade

            airflow users create \
              --username airflow \
              --password airflow \
              --firstname Admin \
              --lastname User \
              --role Admin \
              --email admin@example.com || true
        envFrom:
          - configMapRef:
              name: airflow-env
        volumeMounts:
          - name: airflow-filestore
            mountPath: /opt/airflow
      volumes:
        - name: airflow-filestore
          persistentVolumeClaim:
            claimName: airflow-filestore-pvc
